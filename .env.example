# Neon Postgres — powers the /admin CMS. Without this set, the site and
# admin panel fall back to the existing static project data (read-only).
DATABASE_URL=

# Cloudinary — used by the admin panel's image uploader.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin panel login (single shared password, not a per-user login).
ADMIN_PASSWORD=
# Long random string used to sign admin session cookies, e.g.:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# SMTP (Hostinger email) — used to send contact/enquiry, career application,
# and brochure request emails from the site.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives contact/career/brochure leads. Defaults to SMTP_USER
# in code if unset, but the career/enquire routes currently hardcode
# info@hatchgroup.in — set this to keep it configurable in one place.
LEAD_EMAIL=
